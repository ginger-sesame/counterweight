# Deterministic tests use no credentials or external RPC. Put Foundry 1.8.1 binaries on PATH.
# Optional absolute executable overrides for the isolated prototype runner:
# FORGE_BIN=/path/to/forge
# ANVIL_BIN=/path/to/anvil

# Phase 2 fork proof: optional read-only archive provider override.
# Default: https://eth-mainnet.public.blastapi.io
# ETHEREUM_RPC_URL=https://your-archive-provider
# Export variables in the shell; scripts do not automatically load .env.
